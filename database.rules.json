{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('ownerUid').val() === auth.uid",
        "started": {
          ".write": "auth != null && root.child('rooms').child($roomCode).child('ownerUid').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('started').val() !== true",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length <= 100"
          }
        }
      }
    }
  }
}